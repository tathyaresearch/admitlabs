# What `npm run env:local` writes to .env.local after `npm run db:start`.
# LOCAL development values only, signed with Drishti's own local signing key.
# Never put real service keys here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status
DRISHTI_MAILPIT_URL=http://127.0.0.1:55324

# Optional: switch one provider between mock and real (real providers are not connected yet).
# DRISHTI_PROVIDER_SEARCH=mock
