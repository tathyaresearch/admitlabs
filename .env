# Committed defaults. No secrets here.
# Local Supabase keys live in .env.local (git-ignored), written by `npm run env:local`.

# Keep Next.js from sending anonymous usage data. Everything stays local.
NEXT_TELEMETRY_DISABLED=1

# Where each surface lives. One app answers both addresses (src/lib/hosts.ts): the website, with
# the product page at /drishti, and the dashboard. Change these at deployment; nothing else needs
# to change. Locally the website is admitlabs.localhost:3000 and the dashboard localhost:3000.
NEXT_PUBLIC_SITE_URL=http://admitlabs.localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_URL=http://admitlabs.localhost:3000/drishti
