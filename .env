# Committed defaults. No secrets here.
# Local Supabase keys live in .env.local (git-ignored), written by `npm run env:local`.

# Keep Next.js from sending anonymous usage data. Everything stays local.
NEXT_TELEMETRY_DISABLED=1

# Where each surface lives. Change these at deployment; nothing else needs to change.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_URL=http://localhost:3000/drishti
