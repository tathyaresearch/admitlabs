{
  "name": "drishti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" && node scripts/check-dashes.ts",
    "check:dashes": "node scripts/check-dashes.ts",
    "db:start": "node scripts/ensure-signing-key.ts && supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && node scripts/env-local.ts && node --env-file=.env.local scripts/seed.ts",
    "db:seed": "node --env-file=.env.local scripts/seed.ts",
    "db:types": "node scripts/db-types.ts",
    "db:test": "supabase test db",
    "env:local": "node scripts/env-local.ts",
    "audit": "node --env-file=.env.local scripts/audit.ts",
    "tier": "node --env-file=.env.local scripts/tier.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "typescript": "^5.9.3"
  }
}
