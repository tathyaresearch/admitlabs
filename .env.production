# Production settings, read by `next build` for the live site (Vercel). Committed: no secrets here,
# and no database settings. They win over .env when building for production.

# Where each surface lives (src/lib/hosts.ts): the website at admitlabs.in, with the product page
# at /drishti, and later the dashboard at app.admitlabs.in.
NEXT_PUBLIC_SITE_URL=https://admitlabs.in
NEXT_PUBLIC_APP_URL=https://app.admitlabs.in
NEXT_PUBLIC_PRODUCT_URL=https://admitlabs.in/drishti

# The dashboard is not open yet (src/lib/urls.ts). The website and /drishti are live on their own:
# /signup and /login say "Drishti opens soon." with a way to talk to us, every other dashboard page
# is not found, and nothing reaches a database. Set to true when Drishti opens.
NEXT_PUBLIC_APP_OPEN=false
